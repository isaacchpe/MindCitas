# Puerto del servidor Express
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# URI de conexion a MongoDB Atlas o instancia local
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/mindcitas

# Secreto para firmar access tokens (JWT)
JWT_ACCESS_SECRET=cambiar_por_secreto_seguro

# Duracion del access token (ej: 15m, 1h)
JWT_ACCESS_EXPIRES=15m

# Secreto para firmar refresh tokens (JWT)
JWT_REFRESH_SECRET=cambiar_por_secreto_seguro

# Duracion del refresh token (ej: 7d, 30d)
JWT_REFRESH_EXPIRES=7d

# URL del frontend para configurar CORS
CLIENT_URL=http://localhost:5173

# Rondas de bcrypt para hash de passwords
BCRYPT_ROUNDS=12

# Ventana de rate limiting en milisegundos (15 min)
RATE_LIMIT_WINDOW_MS=900000

# Maximo de peticiones por ventana de rate limiting
RATE_LIMIT_MAX=100

# Remitente para emails (funcionalidad futura)
MAIL_FROM=noreply@mindcitas.local

# URL de transporte SMTP (funcionalidad futura, dejar vacio en dev)
MAIL_TRANSPORT_URL=
