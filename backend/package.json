{
  "name": "mindcitas-backend",
  "version": "1.0.0",
  "description": "Backend de MindCitas",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test PORT=3001 MONGODB_URI=mongodb://127.0.0.1:27017/mindcitas_test JWT_ACCESS_SECRET=test_access JWT_REFRESH_SECRET=test_refresh JWT_ACCESS_EXPIRES=15m JWT_REFRESH_EXPIRES=7d CLIENT_URL=http://localhost:5173 NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,cjs,json}\"",
    "seed": "node scripts/seed.js"
  },
  "author": "Equipo MindCitas",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.0",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  }
}
